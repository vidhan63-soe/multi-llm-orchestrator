# API Keys - Get free tier keys from:
# Groq: https://console.groq.com (RECOMMENDED: FREE, SUPER FAST!)
# OpenAI: https://platform.openai.com/api-keys (OR use Azure OpenAI below)
# Anthropic: https://console.anthropic.com/
# Google: https://ai.google.dev/gemini-api

# Option 1: Groq (RECOMMENDED - FREE & FAST!)
GROQ_API_KEY=gsk_your-groq-key-here

# Option 2: Direct OpenAI API
OPENAI_API_KEY=sk-proj-your-key-here

# Option 3: Azure OpenAI Service (if you have Azure credits)
# Get these from Azure Portal > Azure OpenAI Service > Keys and Endpoint
USE_AZURE_OPENAI=false
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini

# Other providers (use free tiers)
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-key-here

# Optional: Mock mode for testing without API calls
MOCK_MODE=false
